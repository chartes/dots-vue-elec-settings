{
  "collectionId": "elec",
  "renderer": {
    "css": [
      "https://dots.chartes.psl.eu/assets/html.css"
    ],
    "documentContainer": "#center",
    "pageSelectors": [
      "html",
      "body",
      ":root"
    ],
    "facsimiles": [
      {
        "selector": "a.pb[href*='iiif']",
        "image": {
          "attribute": "href"
        }
      },
      {
        "selector": ".lg figure",
        "image": {
          "selector": "a img",
          "attribute": "src"
        }
      }
    ]
  },
  "homePageSettings": {
    "appNavBar": {
      "appNavBarLogo": {
        "imgName": "logo_enc_red_small.svg",
        "href": "https://www.chartes.psl.eu/"
      },
      "collectionShortTitle": "Élec",
      "appNavBarApiLogo": {
        "imgName": "logo_api.svg",
        "href": "https://dots-suite.github.io/dots_documentation/api/"
      }
    },

    "pageHeader": {
      "collectionAltTitle": "Éditions en ligne de l'École des chartes",
      "aboutButtonText": "À propos",
      "aboutOpenState": true
    },
    "descriptionSection": {
      "collectionDescription": "",
      "customCollectionDescription": { "compName": "HomePageContent" }
    },
    "listSection": {
      "displayMode": "card",
      "cardCollectionPerPage": 9,
      "logo": ""
    },
    "filters": {
      "Actes diplomatiques": ["christofle", "cartulaires", "morchesne", "editsdepacification"],
      "Textes juridiques": ["cjc"],
      "Documents d’archives": ["montferrand", "obituairestmont", "dubourg", "saintgermaindespres"],
      "Textes historiographiques et liturgiques": ["sanctoral", "chroniqueslatines"],
      "Actes de colloques": ["cid"],
      "Outils et méthodes": ["ducange", "interpares2"]
    },
    "filtersCard": {
      "title": "Filtres",
      "allLabel": "Tous"
    }
  },

  "footerSettings": {
    "footerTitle": "ELEC",
    "footerSubtitles": [
      "Édition en ligne de l'école des chartes"
    ],
    "footerDescription": null,
    "footerLogos": {
      "biblissima": null
    }
  },

  "aboutPageSettings": [
    null,
    null,
    null
  ],

  "collectionCustomCss": "elec",
  "collectionCustomFonts": "elec",
  "collectionCustomJs": "elec",
  "excludeCollectionIds": ["corpus", "bfm"],
  "searchConfig": {
    "facets": [
      {
        "key": "resources",
        "enabled": false
      }
    ],
    "temporalFacets": [
      {
        "key": "dublinCore.coverage",
        "label": "Période couverte",
        "enabled": true,
        "order": 1
      },
      {
        "key": "dublinCore.created",
        "label": "Date de création",
        "enabled": true,
        "order": 2
      }
    ],
    "searchType": {
      "default": "fulltext",
      "options": {
        "notice": { "labels": { "long": "notices", "short": "notices" }, "prefix": false, "minTermLength": 3 },
        "fulltext": { "labels": { "long": "plein texte", "short": "texte" }, "prefix": false, "minTermLength": 3 }
      }
    }
  }
}
