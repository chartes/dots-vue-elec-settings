{
  "collectionId": "elec",
  "renderer": {
    "css": [
      "https://dots.chartes.psl.eu/assets/html.css"
    ],
    "documentContainer": "#center",
    "pageSelectors": [
      "html",
      "body",
      ":root"
    ],
    "facsimiles": [
      {
        "selector": "a.pb[href*='iiif']",
        "image": {
          "attribute": "href"
        }
      },
      {
        "selector": ".lg figure",
        "image": {
          "selector": "a img",
          "attribute": "src"
        }
      }
    ]
  },
  "homePageSettings": {
    "appNavBar": {
      "appNavBarLogo": {
        "imgName": "logo_enc_red_small.svg",
        "href": "https://www.chartes.psl.eu/"
      },
      "collectionShortTitle": "Élec",
      "appNavBarApiLogo": {
        "imgName": "logo_api.svg",
        "href": "https://dots-suite.github.io/dots_documentation/api/"
      }
    },

    "pageHeader": {
      "collectionAltTitle": "Éditions en ligne de l'École des chartes",
      "aboutButtonText": "À propos"
    },
    "descriptionSection": {
      "collectionDescription": "",
      "customCollectionDescription": { "compName": "HomePageContent" }
    },
    "listSection": {
      "displayMode": "card",
      "cardCollectionPerPage": 5,
      "logo": ""
    }
  },

  "footerSettings": {
    "footerTitle": "Élec"
  },

  "aboutPageSettings": [
    null,
    null,
    null
  ],

  "collectionCustomCss": "elec",
  "excludeCollectionIds": ["corpus", "bfm", "ENCPOS", "theater"],
  "searchConfig": {
    "facets": [
      {
        "key": "resources",
        "enabled": false
      }
    ],
    "temporalFacets": [
      {
        "key": "dublinCore.coverage",
        "label": "Période couverte",
        "enabled": true,
        "order": 1
      },
      {
        "key": "dublinCore.created",
        "label": "Date de création",
        "enabled": true,
        "order": 2
      }
    ]
  }
}
